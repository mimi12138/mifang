.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 240rpx;
}

/* ── 大图 ── */
.hero {
  position: relative;
  width: 100%;
  height: calc(100vw * 0.5625);
  background: #E4E3D9;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-ph {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #DDDCD0, #CFCEC0);
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 220rpx;
  background: linear-gradient(to bottom, rgba(0, 0, 0, .42), rgba(0, 0, 0, 0));
  pointer-events: none;
}

.nav {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
}

.nav-row {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 28rpx;
}

.nb {
  height: 64rpx;
  min-width: 64rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .22);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8px);
}

.nb.back::before {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nb.edit {
  margin-left: 16rpx;
  padding: 0 26rpx;
  font-size: 26rpx;
  color: #fff;
  letter-spacing: 1rpx;
}

/* ── 内容 ── */
.body {
  position: relative;
  margin-top: -52rpx;
  background: var(--bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 44rpx 32rpx 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--t1);
  letter-spacing: .5rpx;
  line-height: 1.3;
}

.sub {
  font-size: 26rpx;
  color: var(--t2);
  margin-top: 12rpx;
}

.dot { margin: 0 8rpx; color: var(--t3); }

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.tag {
  font-size: 22rpx;
  color: var(--t2);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
  background: #FFFFFF;
}

/* ── 热量条 ── */
.kbar {
  margin-top: 32rpx;
  background: var(--green-soft);
  border-radius: 26rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kb-left { flex: none; }

.kb-num-row {
  display: flex;
  align-items: baseline;
}

.approx {
  font-size: 30rpx;
  color: var(--green);
  opacity: .55;
  margin-right: 6rpx;
}

.kb-num {
  font-size: 76rpx;
  font-weight: 700;
  color: var(--green);
  line-height: 1;
  font-family: "SF Mono", "DIN Alternate", Menlo, monospace;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
}

.kb-unit {
  font-size: 22rpx;
  color: var(--green);
  opacity: .7;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

.kb-right {
  text-align: right;
  padding-left: 24rpx;
}

.kb-line {
  font-size: 24rpx;
  color: #3A4A3C;
  line-height: 1.85;
}

.kb-warn {
  font-size: 20rpx;
  color: var(--orange);
  margin-top: 6rpx;
}

/* ── 区块 ── */
.sec {
  margin-top: 52rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--t1);
  letter-spacing: 1rpx;
}

.toggle {
  font-size: 22rpx;
  color: var(--t2);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  background: #FFFFFF;
}

.toggle.on {
  color: var(--orange);
  border-color: rgba(196, 112, 58, .3);
  background: rgba(196, 112, 58, .07);
}

.group {
  margin-top: 20rpx;
}

.g-name {
  font-size: 24rpx;
  color: var(--t2);
  font-weight: 600;
  padding: 14rpx 0 10rpx;
  letter-spacing: .5rpx;
}

.ing {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.ing:last-child { border-bottom: none; }

.ing-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--t1);
}

.ing-qty {
  font-size: 28rpx;
  color: var(--t2);
  margin-right: 32rpx;
  font-variant-numeric: tabular-nums;
}

.ing-kcal {
  width: 92rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--t1);
  font-variant-numeric: tabular-nums;
  font-family: "SF Mono", "DIN Alternate", Menlo, monospace;
}

.ing-kcal.dim { color: var(--t3); }

.ing-approx {
  font-size: 24rpx;
  color: var(--t3);
  margin-right: 2rpx;
}

/* ── 步骤 ── */
.step {
  display: flex;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.step:last-child { border-bottom: none; }

.s-no {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--green-soft);
  color: var(--green);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  margin-top: 4rpx;
}

.s-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.75;
  color: var(--t1);
}

.cooked {
  margin-top: 52rpx;
  font-size: 24rpx;
  color: var(--t3);
  text-align: center;
}

/* ── 底部 ── */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--bg) 62%, rgba(244, 243, 237, 0));
  z-index: 30;
}

.f-btn {
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.f-btn.ghost {
  flex: 0 0 240rpx;
  background: #FFFFFF;
  color: var(--green);
  border: 1rpx solid var(--line);
  font-size: 28rpx;
}

.f-btn.solid {
  flex: 1;
  background: var(--green);
  color: #F4F3ED;
  font-weight: 600;
  font-size: 32rpx;
  letter-spacing: 8rpx;
}

.f-hover { opacity: .85; }
