<view class="page">

  <!-- 图片 -->
  <view class="sec-title">图片</view>
  <view class="card">
    <view
      class="q {{quality === item.key ? 'on' : ''}}"
      wx:for="{{qualityOptions}}"
      wx:key="key"
      data-q="{{item.key}}"
      bindtap="pickQuality"
    >
      <view class="q-main">
        <view class="q-label">{{item.label}}</view>
        <view class="q-desc">{{item.desc}}</view>
      </view>
      <view class="radio {{quality === item.key ? 'on' : ''}}"></view>
    </view>
  </view>

  <!-- 存储 -->
  <view class="sec-title">存储</view>
  <view class="card pad">
    <view class="st-row">
      <text class="st-lbl">图片占用</text>
      <text class="st-val">{{info.imageMB}} / 200 MB</text>
    </view>
    <view class="bar">
      <view class="bar-in" style="width:{{percent}}%"></view>
    </view>
    <view class="st-sub">菜谱 {{info.recipeCount}} 个 · 一桌 {{info.mealCount}} 个 · 图片 {{info.imageCount}} 张</view>
  </view>
  <view class="card">
    <view class="row" bindtap="cleanOrphans" hover-class="row-hover">
      <text>清理无主图片</text>
      <text class="row-val">编辑中途退出留下的</text>
    </view>
  </view>

  <!-- 勺重 -->
  <view class="sec-title">
    勺重
    <text class="sec-note">拿实物称一次，改这里的数</text>
  </view>
  <view class="card">
    <view class="sp-head">
      <text class="sp-h-name">调料</text>
      <text class="sp-h-unit">小勺 g</text>
      <text class="sp-h-unit">汤勺 g</text>
    </view>
    <block wx:for="{{spoons}}" wx:key="name">
      <view class="sp-row" wx:if="{{showAllSpoons || index < 8}}">
        <view class="sp-name">
          {{item.name}}
          <text class="sp-dot" wx:if="{{item.isCustom}}"></text>
        </view>
        <input
          class="sp-ipt"
          type="digit"
          value="{{item.smallText}}"
          data-i="{{index}}"
          data-k="small"
          bindinput="onSpoonInput"
          bindblur="onSpoonBlur"
        />
        <input
          class="sp-ipt"
          type="digit"
          value="{{item.bigText}}"
          data-i="{{index}}"
          data-k="big"
          bindinput="onSpoonInput"
          bindblur="onSpoonBlur"
        />
      </view>
    </block>
    <view class="sp-more" bindtap="toggleAllSpoons">
      {{showAllSpoons ? '收起' : '展开全部调料'}}
    </view>
  </view>
  <view class="card">
    <view class="row" bindtap="resetSpoons" hover-class="row-hover">
      <text>恢复通用勺重</text>
      <text class="row-val">清掉你改过的数</text>
    </view>
  </view>

  <!-- 备份 -->
  <view class="sec-title">
    备份
    <text class="sec-note">换手机前必做</text>
  </view>
  <view class="card">
    <view class="row" bindtap="exportBackup" hover-class="row-hover">
      <text>导出备份</text>
      <text class="row-val">发到文件传输助手</text>
    </view>
    <view class="row" bindtap="importBackup" hover-class="row-hover">
      <text>导入备份</text>
      <text class="row-val">从聊天记录选文件</text>
    </view>
    <view class="row" bindtap="recoverSnapshot" hover-class="row-hover">
      <text>恢复本机快照</text>
      <text class="row-val">{{snapVal}}</text>
    </view>
    <view class="row plain">
      <text>上次备份</text>
      <text class="row-val">{{lastBackupText}}</text>
    </view>
  </view>
  <view class="tip">每次保存菜谱都会自动在本机留一份快照，数据突然变空时会问你要不要恢复。但快照和小程序数据存在同一个沙箱里——在开发者工具里点「清缓存 → 全部清除」会连快照一起清掉，那就真没了。所以真正的保险是「导出备份」发到聊天。</view>

  <!-- 危险 -->
  <view class="card">
    <view class="row danger" bindtap="clearAll" hover-class="row-hover">
      <text>清空全部数据</text>
    </view>
  </view>

  <view class="foot">蜜方 · 数据只存在这台手机上</view>
  <view class="space"></view>
</view>
