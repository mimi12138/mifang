.page {
  padding: 28rpx 32rpx 0;
  background: var(--bg);
  min-height: 100vh;
}

.sec-title {
  font-size: 26rpx;
  color: var(--t2);
  font-weight: 600;
  letter-spacing: 1rpx;
  margin: 40rpx 8rpx 14rpx;
  display: flex;
  align-items: baseline;
}

.sec-note {
  font-size: 21rpx;
  color: var(--t3);
  font-weight: 400;
  margin-left: 14rpx;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.card.pad {
  padding: 30rpx 28rpx;
}

/* ── 画质 ── */
.q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.q:last-child { border-bottom: none; }

.q-main { flex: 1; }

.q-label {
  font-size: 30rpx;
  color: var(--t1);
  font-weight: 500;
}

.q.on .q-label { font-weight: 600; }

.q-desc {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.radio {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #D6D5C9;
  position: relative;
}

.radio.on {
  border-color: var(--green);
}

.radio.on::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  margin: -10rpx 0 0 -10rpx;
  border-radius: 50%;
  background: var(--green);
}

/* ── 存储 ── */
.st-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.st-lbl {
  font-size: 28rpx;
  color: var(--t1);
}

.st-val {
  font-size: 26rpx;
  color: var(--t2);
  font-variant-numeric: tabular-nums;
}

.bar {
  height: 12rpx;
  background: #EFEEE6;
  border-radius: 999rpx;
  margin: 20rpx 0 16rpx;
  overflow: hidden;
}

.bar-in {
  height: 100%;
  background: var(--green);
  border-radius: 999rpx;
  min-width: 4rpx;
}

.st-sub {
  font-size: 22rpx;
  color: var(--t3);
}

/* ── 行 ── */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 30rpx;
  color: var(--t1);
}

.row:last-child { border-bottom: none; }

.row-hover { background: #FAF9F4; }

.row-val {
  font-size: 24rpx;
  color: var(--t3);
}

.row.plain .row-val { color: var(--t2); }

.row.danger {
  justify-content: center;
  color: var(--danger);
}

/* ── 勺重 ── */
.sp-head {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx 14rpx;
  border-bottom: 1rpx solid var(--line);
}

.sp-h-name {
  flex: 1;
  font-size: 21rpx;
  color: var(--t3);
}

.sp-h-unit {
  width: 150rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--t3);
}

.sp-row {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.sp-row:last-child { border-bottom: none; }

.sp-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--t1);
  display: flex;
  align-items: center;
}

.sp-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--orange);
  margin-left: 10rpx;
}

.sp-ipt {
  width: 130rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: #F7F6F0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--t1);
  font-variant-numeric: tabular-nums;
  margin: 0 10rpx;
}

.sp-more {
  padding: 26rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--t2);
}

/* ── 说明 ── */
.tip {
  font-size: 22rpx;
  color: var(--t3);
  line-height: 1.8;
  padding: 6rpx 10rpx 20rpx;
}

.foot {
  text-align: center;
  font-size: 21rpx;
  color: var(--t3);
  padding: 50rpx 0 10rpx;
}

.space {
  height: 60rpx;
}
