.page {
  min-height: 100vh;
  padding: 0 32rpx 200rpx;
  background: var(--bg);
}

/* ── 顶部 ── */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 8rpx;
}

.tabs {
  display: flex;
  align-items: baseline;
}

.tab {
  font-size: 42rpx;
  font-weight: 600;
  color: var(--t3);
  margin-right: 40rpx;
  letter-spacing: 1rpx;
  transition: color .18s;
}

.tab.on { color: var(--t1); }

.cnt {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--t3);
  margin-left: 8rpx;
}

.gear {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.gear-hover { background: rgba(0, 0, 0, .04); }

.gear .dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--t2);
}

.gear .dot + .dot { margin-left: 7rpx; }

/* ── 搜索 ── */
.search {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 0 28rpx;
  margin: 20rpx 0 8rpx;
}

.ico {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid var(--t3);
  border-radius: 50%;
  position: relative;
  margin-right: 18rpx;
  flex: none;
}

.ico::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -5rpx;
  width: 12rpx;
  height: 3rpx;
  background: var(--t3);
  transform: rotate(45deg);
}

.search .ipt {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  min-height: 80rpx;
  font-size: 28rpx;
  color: var(--t1);
  background: #FFFFFF !important;
  background-color: #FFFFFF !important;
  border: none !important;
  box-shadow: none;
  padding: 0;
}

.ph { color: var(--t3); }

.clear {
  font-size: 34rpx;
  color: var(--t3);
  padding: 0 6rpx;
  line-height: 1;
}

/* ── 分类 ── */
.cats {
  width: 100%;
  margin: 12rpx 0 4rpx;
  white-space: nowrap;
}

.cat-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.cat-row .chip {
  margin-right: 12rpx;
  flex: none;
  border: 1rpx solid rgba(0, 0, 0, .05);
  background: #FFFFFF;
}

.cat-row .chip.on {
  background: var(--green-soft);
  border-color: transparent;
}

/* ── 卡片 ── */
.list {
  margin-top: 12rpx;
}

.card {
  background: var(--card);
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.card-hover { transform: scale(.995); opacity: .94; }

.cover {
  position: relative;
  width: 100%;
  height: 386rpx;
  background: #EDECE4;
}

.img {
  width: 100%;
  height: 100%;
  display: block;
}

.ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #E8E7DD, #DDDCD0);
}

.ph text {
  font-size: 110rpx;
  color: #FFFFFF;
  font-weight: 700;
  opacity: .8;
}

.warn {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  background: rgba(30, 58, 37, .78);
  color: #EFEEE8;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 26rpx;
}

.info {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--t1);
  letter-spacing: .5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  font-size: 24rpx;
  color: var(--t2);
  margin-top: 8rpx;
}

.sep { margin: 0 8rpx; color: var(--t3); }

.kcal {
  text-align: right;
  flex: none;
}

.kcal .num {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.1;
  font-family: "SF Mono", "DIN Alternate", Menlo, monospace;
  font-variant-numeric: tabular-nums;
}

.kcal .unit {
  font-size: 20rpx;
  color: var(--t3);
  margin-top: 2rpx;
}

.kcal.low .num { color: var(--kcal-low); }
.kcal.mid .num { color: var(--kcal-mid); }
.kcal.high .num { color: var(--kcal-high); }
.kcal.none .num { color: var(--t3); }

/* ── 一桌卡片 ── */
.mcard {
  background: var(--card);
  border-radius: 28rpx;
  padding: 32rpx 30rpx 28rpx;
  margin-bottom: 24rpx;
}

.m-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.m-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--t1);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-people {
  flex: none;
  font-size: 22rpx;
  color: var(--green);
  background: var(--green-soft);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.m-meta {
  font-size: 24rpx;
  color: var(--t2);
  margin-top: 10rpx;
}

.m-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.m-kcal .num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--t1);
  font-family: "SF Mono", "DIN Alternate", Menlo, monospace;
  font-variant-numeric: tabular-nums;
}

.m-kcal .unit {
  font-size: 22rpx;
  color: var(--t2);
  margin-left: 10rpx;
}

.m-per {
  font-size: 24rpx;
  color: var(--t2);
}

/* ── 空状态 ── */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--t3);
  font-size: 28rpx;
  line-height: 2;
}

.link {
  color: var(--green);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

/* ── 悬浮按钮 ── */
.fab-wrap {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.fab {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--green);
  color: #F4F3ED;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(30, 58, 37, .28);
}

.fab-hover { transform: scale(.94); opacity: .9; }
